# Local development; Docker Compose supplies its own container paths and Redis URLs.
MUSICGEN_RUN_MODE=local
MUSICGEN_CHECKPOINT_PATH=models/best.pt
MUSICGEN_OUTPUT_DIR=storage/generated
MUSICGEN_DEVICE=auto
MUSICGEN_TORCH_THREADS=2
MUSICGEN_PALETTE=original
MUSICGEN_ENDING_STYLE=release
MUSICGEN_REPETITION_PENALTY=0.3
MUSICGEN_DEFAULT_DURATION_SECONDS=45
MUSICGEN_MAX_DURATION_SECONDS=240
MUSICGEN_GENERATION_TIMEOUT_SECONDS=1800
MUSICGEN_MAX_PENDING_JOBS=32
MUSICGEN_JOB_RETENTION_SECONDS=604800
MUSICGEN_BROKER_URL=redis://localhost:6379/0
MUSICGEN_RESULT_BACKEND=redis://localhost:6379/1
MUSICGEN_JOB_STORE_URL=redis://localhost:6379/2
MUSICGEN_FRONTEND_ORIGIN=http://localhost:5000
MUSICGEN_API_BASE_URL=http://localhost:8000
MUSICGEN_LOG_LEVEL=INFO

# Shared admin login; create accounts with scripts/manage_admin.py.
MUSICGEN_ADMIN_DB_PATH=storage/admin/admin.sqlite3
MUSICGEN_ADMIN_SESSION_SECONDS=28800
MUSICGEN_ADMIN_COOKIE_SECURE=false

# Compose entry point and internal authentication.
# Generate a URL-safe Redis machine secret of at least 32 characters; never reuse an admin password.
MUSICGEN_REDIS_PASSWORD=
MUSICGEN_HTTP_PORT=8080
MUSICGEN_PUBLIC_ORIGIN=http://localhost:8080
MUSICGEN_ADMIN_NETWORK_SUBNET=172.30.250.0/24
MUSICGEN_ADMIN_NETWORK_RANGE=172.30.250.128/25
MUSICGEN_ADMIN_PROXY_IP=172.30.250.2
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=replace_with_your_local_password
